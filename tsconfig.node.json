{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./out",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/main/*"]
    },
    "types": ["node", "electron-vite/node"],
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/lib/**/*",
    "src/renderer/office/fixture/fixture-projects.ts",
    "src/renderer/office/fixture/fixture-sessions.ts",
    "src/renderer/office-live/world-document-store.ts",
    "src/renderer/office-live/world-document-storage.ts",
    "src/renderer/office-live/world-document-transactions.ts",
    "src/bridge/**/*",
    "src/shared/**/*",
    "src/office/sim/**/*",
    "src/office-host/**/*",
    "src/office-web/**/*",
    "electron.vite.config.ts"
  ]
}
